<Configuration status="WARN">
  <Appenders>
    <Console name="STDOUT" target="SYSTEM_OUT">

      <!-- This is a JSON format that can be read by the Stackdriver Logging agent. The trace ID,
           span ID and sampling decision are not added here: stdout belongs to the independent
           conventional pipeline. The timestamp is retained for that pipeline.
           (https://cloud.google.com/logging/docs/agent/configuration#special-fields). -->

      <JsonLayout compact="true" eventEol="true">
        <KeyValuePair key="time" value="$${date:yyyy-MM-dd}T$${date:HH:mm:ss.SSS}Z"/>
     </JsonLayout>

    </Console>
    <OpenTelemetry name="OTel"/>
  </Appenders>
  <Loggers>
    <Logger name="io.grpc.netty" level="INFO"/>
    <Logger name="io.netty" level="INFO"/>
    <Logger name="sun.net" level="INFO"/>
    <Root level="TRACE">
      <AppenderRef ref="STDOUT"/>
      <AppenderRef ref="OTel"/>
    </Root>
  </Loggers>
</Configuration>
