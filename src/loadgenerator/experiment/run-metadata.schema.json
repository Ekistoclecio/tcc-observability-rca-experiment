{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tcc:workload-run-metadata:1.1",
  "title": "TCC open-loop workload run metadata",
  "type": "object",
  "required": [
    "schema_version", "run_id", "benchmark", "benchmark_version", "executor", "workload_model",
    "seed", "product_id", "target_flow_rate_per_second", "max_in_flight_flows",
    "warmup_flows", "warmup_requests", "flows", "scheduled_flows", "started_flows",
    "completed_flows", "failed_flows", "control_plane_dropped_flows", "control_plane_drops_by_reason",
    "start_lag_ms", "requests", "observed_flow_start_rate_per_second",
    "observed_flow_completion_rate_per_second", "pod_state_before", "pod_state_after", "result"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"type": "string", "minLength": 1},
    "benchmark": {"const": "Google Online Boutique"},
    "benchmark_version": {"const": "v0.10.7"},
    "benchmark_commit": {"type": ["string", "null"]},
    "executor": {"enum": ["host-wsl", "kubernetes-job-auxiliary"]},
    "workload_model": {"const": "open-loop"},
    "seed": {"type": "integer"},
    "product_id": {"type": "string"},
    "checkout_profile": {"type": "string"},
    "checkout_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "flow_identity_scheme": {"type": "string"},
    "control_plane_ids_propagated_to_sut": {"const": false},
    "target_flow_rate_per_second": {"type": "number", "exclusiveMinimum": 0},
    "max_in_flight_flows": {"type": "integer", "minimum": 1},
    "observed_peak_in_flight_flows": {"type": "integer", "minimum": 0},
    "warmup_peak_in_flight_flows": {"type": "integer", "minimum": 0},
    "duration_seconds_configured": {"type": "number", "exclusiveMinimum": 0},
    "warmup_seconds_configured": {"type": "number", "minimum": 0},
    "cooldown_seconds_configured": {"type": "number", "minimum": 0},
    "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "setup_started_at": {"type": "string", "format": "date-time"},
    "warmup_started_at": {"type": ["string", "null"], "format": "date-time"},
    "warmup_ended_at": {"type": ["string", "null"], "format": "date-time"},
    "workload_started_at": {"type": ["string", "null"], "format": "date-time"},
    "admission_stopped_at": {"type": ["string", "null"], "format": "date-time"},
    "workload_ended_at": {"type": ["string", "null"], "format": "date-time"},
    "cooldown_started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "warmup_duration_seconds_actual": {"type": ["number", "null"]},
    "steady_admission_seconds_actual": {"type": ["number", "null"]},
    "workload_duration_seconds_actual": {"type": ["number", "null"]},
    "cooldown_duration_seconds_actual": {"type": ["number", "null"]},
    "warmup_flows": {"$ref": "#/$defs/flowCounts"},
    "flows": {"$ref": "#/$defs/flowCounts"},
    "scheduled_flows": {"type": "integer", "minimum": 0},
    "started_flows": {"type": "integer", "minimum": 0},
    "completed_flows": {"type": "integer", "minimum": 0},
    "failed_flows": {"type": "integer", "minimum": 0},
    "control_plane_dropped_flows": {"type": "integer", "minimum": 0},
    "control_plane_drops_by_reason": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "warmup_control_plane_drops_by_reason": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "start_lag_ms": {"type": "object", "additionalProperties": {"$ref": "#/$defs/lagSummary"}},
    "warmup_requests": {"$ref": "#/$defs/requestStats"},
    "requests": {"$ref": "#/$defs/requestStats"},
    "observed_flow_start_rate_per_second": {"type": ["number", "null"]},
    "observed_flow_completion_rate_per_second": {"type": ["number", "null"]},
    "observed_requests_per_second": {"type": ["number", "null"]},
    "observed_flows_per_second": {"type": ["number", "null"]},
    "failures_by_stage": {"type": "object", "additionalProperties": {"type": "integer"}},
    "failed_flow_samples": {"type": "array", "items": {"type": "object"}},
    "pod_state_before": {"type": "array", "items": {"$ref": "#/$defs/pod"}},
    "pod_state_after": {"type": "array", "items": {"$ref": "#/$defs/pod"}},
    "result": {"enum": ["running", "passed", "completed_with_flow_failures", "completed_with_control_plane_drops", "failed"]},
    "fatal_error": {"type": "string"}
  },
  "$defs": {
    "flowCounts": {
      "type": "object",
      "required": ["scheduled", "started", "completed", "failed", "control_plane_dropped"],
      "properties": {
        "scheduled": {"type": "integer", "minimum": 0},
        "started": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "control_plane_dropped": {"type": "integer", "minimum": 0}
      }
    },
    "lagSummary": {
      "type": "object",
      "required": ["count", "average", "p50", "p95", "p99", "max"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "average": {"type": ["number", "null"]},
        "p50": {"type": ["number", "null"]},
        "p95": {"type": ["number", "null"]},
        "p99": {"type": ["number", "null"]},
        "max": {"type": ["number", "null"]}
      }
    },
    "requestStats": {
      "type": "object",
      "required": ["total", "successful", "failed", "latency_ms", "by_stage"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "successful": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "latency_ms": {"$ref": "#/$defs/lagSummary"},
        "by_stage": {"type": "object"}
      }
    },
    "pod": {
      "type": "object",
      "required": ["namespace", "name", "phase", "ready", "restarts"],
      "properties": {
        "namespace": {"type": "string"},
        "name": {"type": "string"},
        "phase": {"type": ["string", "null"]},
        "ready": {"type": "boolean"},
        "restarts": {"type": "integer", "minimum": 0}
      }
    }
  }
}
