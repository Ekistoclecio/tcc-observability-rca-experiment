  "coverage_status": "complete",
  "fault_observation_coverage": {
    "cpu_saturation": {
      "required": [
        "cpu_utilization",
        "request_duration",
        "request_count/outcome"
      ],
      "source_status": "partial",
      "reason": "CPU comes from shared cAdvisor source; request observations are not yet paired for every service."
    },
    "network_latency": {
      "required": [
        "CLIENT checkoutservice→paymentservice duration/outcome"
      ],
      "source_status": "implemented_for_checkoutservice_only",
      "reason": "Checkout client observation is shared; service-wide paired observation coverage remains partial."
    },
    "service_unavailable": {
      "required": [
        "CLIENT checkoutservice→paymentservice ERROR"
      ],
      "source_status": "implemented_for_checkoutservice_only",
      "reason": "Checkout client observation is shared; event and metrics must be confirmed from both adapters."
    },
    "application_exception": {
      "required": [
        "SERVER paymentservice/Charge ERROR",
        "payment_charge_failed"
      ],
      "source_status": "partial",
      "reason": "Payment source defines the event, but historical artifacts lack explicit shared markers and current dual-adapter emission has not been smoke-validated."
    },
    "datastore_unavailable": {
      "required": [
        "DATASTORE cartservice→redis-cart ERROR",
        "datastore_operation_failed"
      ],
      "source_status": "partial",
      "reason": "Cart shared event adapter was changed; paired source observations and current run remain unvalidated."
    }
  },
  "coverage_version": "shared-observation-v1-final-static-review"
