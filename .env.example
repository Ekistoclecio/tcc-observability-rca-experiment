# ============================================================
# Experiment faults
#
# Value = number of physical repetitions in this run.
# 0 disables the fault.
# ============================================================

EXPERIMENT_F1_CPU_SATURATION=1
EXPERIMENT_F2_NETWORK_LATENCY=1
EXPERIMENT_F3_SERVICE_UNAVAILABLE=1
EXPERIMENT_F4_APPLICATION_EXCEPTION=1
EXPERIMENT_F5_DATASTORE_UNAVAILABLE=1


# ============================================================
# RCA / OpenAI
# ============================================================

OPENAI_API_KEY=

RCA_ENABLED=true

RCA_MODEL=gpt-6-luna
RCA_REASONING_MODE=standard
RCA_REASONING_EFFORT=medium
RCA_MAX_OUTPUT_TOKENS=16384
RCA_SERVICE_TIER=default


# ============================================================
# Evaluation
# ============================================================

EVALUATION_ENABLED=true
