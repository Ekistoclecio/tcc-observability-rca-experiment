{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcc.example/schemas/dataset-stats-1.0.schema.json",
  "title": "TCC dataset statistics",
  "type": "object",
  "required": ["schema_version", "run_id", "scenario", "metrics", "logs", "traces", "total_raw_bytes", "total_normalized_bytes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "scenario": {"enum": ["A", "B"]},
    "metrics": {"type": "object"}, "logs": {"type": "object"}, "traces": {"type": "object"},
    "total_raw_bytes": {"type": "integer", "minimum": 0},
    "total_normalized_bytes": {"type": "integer", "minimum": 0}
  }
}
